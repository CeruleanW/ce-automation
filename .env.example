# Path to the api-integrator repo (the engine ce-automation shells out to).
API_INTEGRATOR_DIR=/ai-projects/api-integrator

# When "true", ce email:send fetches and renders the course email but skips gws auth and sending.
CE_DRY_RUN=

# ISO date; overrides "now" for timing-rule tests of email/promote orchestrators.
CE_NOW_OVERRIDE=

# Comma-separated email addresses; default recipient list for `ce email:send` (Op 5, per ADR-0005).
CE_EMAIL_RECIPIENTS=
